# copy this file to .env and fill in the values, .env is ignored by git.
# non secret settings live in configs. any variable named AIRPULSE_<section>__<key> overrides the
# merged config, nested keys are joined with a double underscore. lists are comma separated.

# profile to load when a job is started without a config path, one of dev, demo, bench.
AIRPULSE_PROFILE=

# api keys, leave empty for sources that do not need one.
AIRPULSE_SOURCES__OPENAQ__API_KEY=
AIRPULSE_SOURCES__OPENWEATHERMAP__API_KEY=

# endpoints that depend on where the code runs, for example when running outside the cluster.
AIRPULSE_KAFKA__BOOTSTRAP_SERVERS=
AIRPULSE_HDFS__URL=
AIRPULSE_CASSANDRA__HOSTS=
AIRPULSE_TRINO__URL=
AIRPULSE_SPARK__MASTER=
