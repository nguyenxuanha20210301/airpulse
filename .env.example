# copy this file to .env and fill in the values, .env is ignored by git.
# non secret settings live in configs, any variable with the AIRPULSE_ prefix overrides them.

# config profile to load, one of dev, demo, bench.
AIRPULSE_PROFILE=

# api keys, leave empty for sources that do not need one.
AIRPULSE_OPENAQ_API_KEY=
AIRPULSE_OPENWEATHERMAP_API_KEY=

# endpoints that depend on where the code runs, for example when running outside the cluster.
AIRPULSE_KAFKA_BOOTSTRAP_SERVERS=
AIRPULSE_HDFS_URL=
AIRPULSE_CASSANDRA_HOSTS=
AIRPULSE_TRINO_URL=
